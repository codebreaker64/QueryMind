# Copy this file to .env in the repository root and fill in the values.

# Required: the agent's model calls go through Gemini's OpenAI-compatible API.
GEMINI_API_KEY=
# Required: web search. Free tier at https://tavily.com
TAVILY_API_KEY=

# Optional: Google sign-in. Without it, use "Continue without an account".
VITE_GOOGLE_CLIENT_ID=
# Change this before deploying anywhere.
JWT_SECRET=change-me

# Optional: session history. Falls back to in-memory storage if Redis is unreachable.
REDIS_URL=redis://localhost:6379

# Optional agent tuning (defaults shown).
MODEL_NAME=gemma-4-31b-it
MAX_STEPS=15
MAX_TIME_LIMIT=300
STEP_DELAY=2.0
# On a 429 from the model API, wait this long (seconds) and retry, up to this many times.
RATE_LIMIT_WAIT=60
RATE_LIMIT_RETRIES=2
# OPENAI_BASE_URL=   # point at any other OpenAI-compatible endpoint
